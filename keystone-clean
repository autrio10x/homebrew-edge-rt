#!/usr/bin/env bash
# Full local purge for brew Keystone (run while the formula is still installed).
#
# Homebrew never deletes etc/ on `brew uninstall` (by design — protects operator
# config). This helper removes Keychain + package etc/var so uninstall is clean.
#
#   brew services stop autrio10x/edge-rt/keystone
#   keystone-clean
#   brew uninstall autrio10x/edge-rt/keystone
set -euo pipefail

PREFIX="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
ETC_DIR="${PREFIX}/etc/keystone"
VAR_DIR="${PREFIX}/var/keystone"
LOG_OUT="${PREFIX}/var/log/keystone.log"
LOG_ERR="${PREFIX}/var/log/keystone.err.log"
LAUNCH_AGENT="${HOME}/Library/LaunchAgents/sh.brew.keystone.plist"

mac_keychain_delete_service() {
  local service="$1"
  local n=0
  local acct
  for acct in \
    join_secret_birth \
    join_secret_operational \
    access_token \
    access_token_expires_at \
    birth_cert \
    birth_key \
    operational_cert \
    operational_key \
    ca_chain \
    domain_enrichment \
    session_mqtt_auth; do
    if security delete-generic-password -s "${service}" -a "${acct}" >/dev/null 2>&1; then
      echo "  deleted -s ${service} -a ${acct}"
      n=$((n + 1))
    fi
  done
  while security delete-generic-password -s "${service}" >/dev/null 2>&1; do
    echo "  deleted -s ${service} (remaining item)"
    n=$((n + 1))
    if [[ "${n}" -gt 64 ]]; then
      echo "warn: stopped after 64 deletes for ${service}" >&2
      break
    fi
  done
  echo "keychain service ${service}: removed ${n} item(s)"
}

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "keystone-clean: macOS only" >&2
  exit 2
fi

echo "removing macOS Keychain slots (com.autrio.keystone + legacy)"
mac_keychain_delete_service "com.autrio.keystone"
mac_keychain_delete_service "com.drivestream.keystone"

if [[ -d "$ETC_DIR" ]]; then
  echo "removing ${ETC_DIR}"
  rm -rf "$ETC_DIR"
fi
if [[ -d "$VAR_DIR" ]]; then
  echo "removing ${VAR_DIR}"
  rm -rf "$VAR_DIR"
fi
rm -f "$LOG_OUT" "$LOG_ERR" 2>/dev/null || true
if [[ -f "$LAUNCH_AGENT" ]]; then
  echo "removing ${LAUNCH_AGENT}"
  rm -f "$LAUNCH_AGENT"
fi

echo "OK: Keychain + etc/var purged — safe to: brew uninstall autrio10x/edge-rt/keystone"
