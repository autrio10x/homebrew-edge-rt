# Keystone identity — installed as:
#   $(brew --prefix)/etc/keystone/keystone.toml
#
# Package already sets paths, supervisor, and keychain in the brew service.
# Fill day-0 join identity (tenant_key slug + serial), then:
#   brew services start autrio10x/edge-rt/keystone

autrio_url = "http://127.0.0.1:8002"
tenant_key = "helios_edge"
serial = "CHANGE_ME_SERIAL"
birth_secret = "CHANGE_ME_BIRTH_SECRET"
